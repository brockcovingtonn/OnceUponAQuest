{
  "name": "once-upon-a-quest",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:test:remote": "supabase test db --linked",
    "db:use-local": "node scripts/use-supabase.mjs local",
    "db:use-hosted": "node scripts/use-supabase.mjs hosted",
    "legal:export": "node scripts/export-legal.mjs",
    "build:dev:android": "npx eas-cli@latest build --profile development --platform android",
    "build:dev:ios": "npx eas-cli@latest build --profile development --platform ios",
    "build:preview": "npx eas-cli@latest build --profile preview --platform all",
    "build:production": "npx eas-cli@latest build --profile production --platform all",
    "submit:ios": "npx eas-cli@latest submit --profile production --platform ios",
    "submit:android": "npx eas-cli@latest submit --profile production --platform android",
    "auth:code": "node scripts/sign-in-code.mjs",
    "admin:add": "node scripts/make-admin.mjs",
    "build:field": "npx eas-cli@latest build --profile field --platform ios",
    "update:field": "EXPO_PUBLIC_FIELD_TOOLS=true npx eas-cli@latest update --channel field --environment preview --message \"$(git log -1 --pretty=%s)\"",
    "update:preview": "npx eas-cli@latest update --channel preview --environment preview --message \"$(git log -1 --pretty=%s)\"",
    "update:production": "npx eas-cli@latest update --channel production --environment production --message \"$(git log -1 --pretty=%s)\""
  },
  "private": true
}
